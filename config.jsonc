{
    "layer": "top",
    "position": "top",
    "height": 36,
    "spacing": 4,
    "margin-top": 6,
    "margin-left": 12,
    "margin-right": 12,

    "modules-left": [
        "custom/os",
        "hyprland/workspaces",
        "hyprland/window"
    ],

    "modules-center": [
        "clock"
    ],

    "modules-right": [
        "custom/power_profile",
        "cpu",
        "memory",
        "temperature",
        "network",
        "pulseaudio",
        "backlight",
        "battery",
        "tray"
    ],



    "custom/power_profile": {
        "exec": "tuned-adm active | awk '{print $NF}' | sed 's/desktop-powersave/🌱 Save/g' | sed 's/desktop/⚡ Perf/g'",
        "interval": 5,
        "format": "{}",
        "on-click": "~/toggle-power.sh"
    },


    // ── Left ───────────────────────────────────────────────

    "custom/os": {
        "format": " ",
        "tooltip": false,
        "on-click": "fuzzel"
    },

    "hyprland/workspaces": {
        "disable-scroll": false,
        "all-outputs": true,
        "format": "{id}",
        "on-click": "activate",
        "persistent-workspaces": {
            "*": [1, 2, 3, 4, 5]
        }
    },

    "hyprland/window": {
        "format": ">> {}",
        "max-length": 40,
        "separate-outputs": true
    },

    // ── Center ─────────────────────────────────────────────

    "clock": {
	"format": "{:%a %d %b %I:%M:%S %p}",
	//"format-alt": "  {:%a %d %b %Y}",
	"tooltip-format": "<big>{:%B %Y}</big>\n<tt><small>{calendar}</small></tt>",
	"on-click": "mode",
    "interval": 1
     },
    // ── Right ──────────────────────────────────────────────

    "cpu": {
        "format": "󰻠 {usage}%",
        "interval": 2,
        "tooltip": false,
        "on-click": "kitty -e btop"
    },

    "memory": {
        "format": "󰍛 {used}G",
        "interval": 5,
        "tooltip-format": "Total: {total}G\nUsed: {used}G\nFree: {avail}G",
        "on-click": "kitty -e btop"
    },

    "temperature": {
        "thermal-zone": 6,
        "critical-threshold": 80,
        "format": " {temperatureC}°C",
        "format-critical": " {temperatureC}°C",
        "interval": 5
    },

    "network": {
        "format-wifi": "󰖩 {signalStrength}%",
        "format-ethernet": "󰈀 {ipaddr}",
        "format-disconnected": "󰖪 offline",
        "tooltip-format-wifi": "{essid} ({signalStrength}%)\n{ipaddr}",
        "tooltip-format-ethernet": "{ifname}\n{ipaddr}",
        "on-click": "kitty -e nmtui",
        "interval": 5
    },

    "pulseaudio": {
         "format": "{icon} {volume}%",
         "format-muted": "󰝟 muted",
         "format-icons": {
             "default": ["󰕿", "󰖀", "󰕾"]
         },
         "on-click": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
         "on-scroll-up": "wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+",
         "on-scroll-down": "wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%-",
         "scroll-step": 5
    },

       
    "backlight": {
         "device": "intel_backlight",
         "format": "󰃞 {percent}%",
         "on-scroll-up": "brightnessctl set +5%",
         "on-scroll-down": "brightnessctl set 5%-",
         "on-click": "brightnessctl set 50%"
     },


    "battery": {
        "states": {
            "warning": 30,
            "critical": 15
        },
        "bat": "BAT0",
        "format": "{icon} {capacity}% ⚡{power}W",
        "format-charging": "󰂄 {capacity}% ⚡{power}W",
        "format-discharging": "{icon} {capacity}% ↓⚡{power}W",
        "format-plugged": "󰚥 {capacity}%",
        "format-icons": [
            "󰂎", "󰁺", "󰁻", "󰁼", "󰁽",
            "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"
        ],
        "tooltip-format": "{timeTo}\nPower draw: {power}W\nHealth: {health}%\nCycles: {cycles}"
     },

     "tray": {
         "icon-size": 16,
         "spacing": 8
     }
}
